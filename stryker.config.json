{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "mutate": ["server/utils/rate-limiter.ts", "server/utils/mcp-rate-limit.ts"],
  "incremental": true,
  "ignoreStatic": true,
  "reporters": ["progress", "clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "timeoutMS": 60000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "inPlace": true
}
