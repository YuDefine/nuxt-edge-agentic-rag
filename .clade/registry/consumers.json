{
  "$schema": "./consumers.schema.json",
  "$comment": "Stable consumer registry for improvement-loop signal aggregation. Digest aggregation MUST resolve consumer identity through this registry, not through local filesystem paths or git remotes. Adding a new consumer here is the only way to make it discoverable to vendor/scripts/improvement-digest.mjs.",
  "schema_version": "1",
  "consumers": [
    {
      "consumer_id": "clade",
      "repo_id": "YuDefine/clade",
      "role": "source-of-truth",
      "projection_paths": {
        "rules": ".claude/rules/",
        "skills": ".claude/skills/",
        "vendor": "vendor/"
      },
      "standard_completeness_columns": ["audit-pattern", "verify-channel", "improvement-loop"],
      "improvement_loop_enabled": true,
      "business_activity": "active"
    },
    {
      "consumer_id": "perno",
      "repo_id": "BigByte-Education-IT/perno",
      "role": "consumer",
      "onboarded": "2026-04-29",
