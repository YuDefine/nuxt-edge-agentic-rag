        },
        "personal_redactions": {
          "/Users/charles/.local/bin/": "<HOME>/.local/bin/",
          "/Users/charles/offline/clade": "<clade-central-repo>",
          "/Users/charles/offline/": "<home>/offline/",
          "/Users/charles/": "~/",
          "charles@yudefine.com.tw": "<maintainer-email>",
